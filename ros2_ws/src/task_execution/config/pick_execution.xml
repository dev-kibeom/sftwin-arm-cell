<root>
  <BehaviorTree ID="PickExecution">
    <Sequence name="PickExecution">
      <PreparePickCandidate/>
      <OpenAndConfirmPickRelease/>
      <RetryWhileAllowed name="PickPlanningCandidates">
        <Sequence name="ExecutePickCandidatePlan">
          <Fallback>
            <Sequence>
              <UsesPreparedGrasp/>
              <RunAndFinalize>
                <MoveTaught motion="{grasp_approach_motion}"/>
                <RecordTaughtPickApproach/>
              </RunAndFinalize>
            </Sequence>
            <Sequence>
              <UsesPlannedGrasp/>
              <PlanPickApproach/>
              <ExecutePickApproach/>
            </Sequence>
          </Fallback>
          <Fallback>
            <Sequence>
              <UsesPreparedGrasp/>
              <BeginPreparedGraspInsertion/>
              <RunAndFinalize>
                <MoveTaught motion="{grasp_insertion_motion}"/>
                <RecordTaughtPickInsertion/>
              </RunAndFinalize>
            </Sequence>
            <Sequence>
              <UsesPlannedGrasp/>
              <PlanPickGraspInsertion/>
              <ExecutePickGraspInsertion/>
            </Sequence>
          </Fallback>
        </Sequence>
        <AdvancePickPlanningCandidate/>
      </RetryWhileAllowed>
      <RecoverOnFailure name="PickGraspConfirmationRecovery">
        <CloseAndConfirmPickGrasp/>
        <RecoverUnconfirmedPickGrasp/>
      </RecoverOnFailure>
      <RunAndFinalize name="PickRetractAndRecord">
        <RecoverOnFailure name="PickRetractFailureHandling">
          <Fallback name="ExecutePickRetract">
            <Sequence>
              <UsesPreparedGrasp/>
              <MoveTaught motion="{grasp_transfer_motion}"/>
              <RecordTaughtPickTransfer/>
            </Sequence>
            <Sequence name="PlanAndExecutePickRetract">
              <UsesPlannedGrasp/>
              <PlanPickRetract/>
              <ExecutePickRetract/>
            </Sequence>
          </Fallback>
          <SubTree ID="PickRetractFailureRecovery"/>
        </RecoverOnFailure>
        <FinalizePickRetract/>
      </RunAndFinalize>
    </Sequence>
  </BehaviorTree>
</root>
