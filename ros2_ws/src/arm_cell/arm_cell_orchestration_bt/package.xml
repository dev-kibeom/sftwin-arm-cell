<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arm_cell_bt</name>
  <version>0.0.0</version>
  <description>BehaviorTree-based mission orchestration for the ARM Cell.</description>
  <maintainer email="neopkrrl@gmail.com">kibeom</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>builtin_interfaces</depend>
  <depend>arm_cell_interfaces</depend>
  <depend>nlohmann_json</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>arm_cell_motion_moveit2</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
