#!/usr/bin/env python3
"""Export Bringup's assembled settings for Isaac and other external runtimes."""
import argparse
from pathlib import Path

from arm_cell_bringup.runtime import export_runtime_configuration

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--profile', type=Path)
parser.add_argument('--output', type=Path, required=True)
args = parser.parse_args()
if args.profile is None:
    from ament_index_python.packages import get_package_share_directory
    args.profile = Path(get_package_share_directory('arm_cell_bringup')) / 'config/operational_profile.yaml'
print(export_runtime_configuration(args.profile, args.output))
