#!/usr/bin/env python3
"""Export Bringup's assembled settings for Isaac and other external runtimes."""
import argparse
import json
from pathlib import Path

from arm_cell_bringup.runtime import export_runtime_configuration

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--profile', type=Path)
parser.add_argument('--output', type=Path, required=True)
parser.add_argument('--material', dest='material_id')
parser.add_argument('--pick-offset-z-m', type=float)
parser.add_argument('--tool-actuator', help='Selected Tool actuator implementation')
parser.add_argument('--tool-grasp', help='Selected Tool grasp implementation')
parser.add_argument('--tool-parameters-json', type=json.loads, default=None, help='Tool parameter overrides as a JSON object')
parser.add_argument('--component-parameters-json', type=json.loads, default=None,
                    help='Temporary component parameter overrides as a JSON object')
args = parser.parse_args()
if args.profile is None:
    from ament_index_python.packages import get_package_share_directory
    args.profile = Path(get_package_share_directory('arm_cell_bringup')) / 'config/operational_profile.yaml'
print(export_runtime_configuration(
    args.profile, args.output, material_id=args.material_id, pick_offset_z_m=args.pick_offset_z_m,
    tool_actuator=args.tool_actuator, tool_grasp=args.tool_grasp,
    tool_parameters=args.tool_parameters_json, component_parameters=args.component_parameters_json,
))
