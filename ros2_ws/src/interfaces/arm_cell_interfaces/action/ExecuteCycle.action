# target_id is the caller-visible logical work/target selection key.
# The ROS Action Goal UUID is the execution identity.
string target_id
unique_identifier_msgs/UUID delivery_id
---
# DEPLETED is normal completion. Recovery never rewrites the original exit_reason.
MissionExitReason exit_reason
string diagnostic_detail
---
# Feedback is a public mission phase, not a BehaviorTree implementation state.
MissionPhase phase
string diagnostic_detail
unique_identifier_msgs/UUID delivery_id
uint64 batch_processed_count
uint8 retry_count
geometry_msgs/PoseStamped selected_target_pose
bool has_selected_target_pose
bool target_valid
builtin_interfaces/Time target_observation_stamp
uint32 interruption_count
MissionExitReason first_interruption_reason
SafetyCauseSet first_interruption_causes
StopMode first_interruption_stop_mode
