<?xml version='1.0' encoding='utf-8'?>
<robot name="hcr14_hand_e_c10">
  <group name="arm">
    <chain base_link="base_link" tip_link="sf_grasp_tcp" />
  </group>
  <virtual_joint name="world_joint" type="fixed" parent_frame="world" child_link="base_link" />
  <disable_collisions link1="base_link" link2="link0" reason="Adjacent" />
  <disable_collisions link1="link0" link2="link1" reason="Adjacent" />
  <disable_collisions link1="link1" link2="link2" reason="Adjacent" />
  <disable_collisions link1="link2" link2="link3" reason="Adjacent" />
  <disable_collisions link1="link3" link2="link4" reason="Adjacent" />
  <disable_collisions link1="link4" link2="link5" reason="Adjacent" />
  <disable_collisions link1="link5" link2="link6" reason="Adjacent" />
  <disable_collisions link1="link6" link2="flange" reason="Adjacent" />
  <disable_collisions link1="flange" link2="tool_mount" reason="Adjacent" />
  <group name="gripper">
    <link name="gripper_hand_e_c10_base_link" />
    <link name="gripper_hande_c10_finger_1" />
    <link name="gripper_hande_c10_finger_2" />
    <link name="gripper_hande_c10_finger_3" />
  </group>
  <end_effector name="hand_e_c10" parent_link="tool_mount" group="gripper" parent_group="arm" />
  <disable_collisions link1="tool_mount" link2="gripper_hand_e_c10_base_link" reason="Adjacent" />
  <disable_collisions link1="link6" link2="gripper_hand_e_c10_base_link" reason="Rigid tool mount" />
  <disable_collisions link1="gripper_hand_e_c10_base_link" link2="gripper_hande_c10_finger_1" reason="Adjacent" />
  <disable_collisions link1="gripper_hand_e_c10_base_link" link2="gripper_hande_c10_finger_2" reason="Adjacent" />
  <disable_collisions link1="gripper_hand_e_c10_base_link" link2="gripper_hande_c10_finger_3" reason="Adjacent" />
</robot>