# Keep the build context limited to the packages needed for the ROS build.
**
!ros2_ws/
!ros2_ws/src/
!ros2_ws/src/**
!infra/
!infra/plc/
!infra/plc/Conveyor.fbsdev/
!infra/plc/Conveyor.fbsdev/Application.iecapp^/
!infra/plc/Conveyor.fbsdev/Application.iecapp^/PLC_PRG.prg.st

# Exclude local build and interpreter artifacts if present in a checkout.
ros2_ws/src/**/build/
ros2_ws/src/**/install/
ros2_ws/src/**/log/
ros2_ws/src/**/__pycache__/
ros2_ws/src/**/*.pyc
ros2_ws/src/**/.pytest_cache/

!assets/
!assets/**
