<?xml version="1.0"?>

<robot
    xmlns:xacro="http://www.ros.org/wiki/xacro"
    name="m0609_robotiq_2f85">

    <xacro:arg name="mesh_root" default="${xacro.abs_filename('../meshes')}"/>

    <!-- M0609 -->
    <xacro:include filename="m0609_macro.xacro"/>

    <!-- SF-Twin tool abstraction -->
    <xacro:include filename="m0609_tool_adapter.xacro"/>

    <!-- Vendored Robotiq 2F-85 -->
    <xacro:include filename="../../../tools/robotiq_2f85/urdf/assembly.xacro"/>


    <!-- =========================================================
         Robot
         ========================================================= -->

    <xacro:m0609_robot
    mesh_dir="$(arg mesh_root)"/>


    <!-- =========================================================
         SF-Twin standard tool adapter
         ========================================================= -->

    <xacro:m0609_tool_adapter
        parent="tool0"
        adapter_link="sf_tool_adapter"
        mount_link="tool_mount"
        xyz="0 0 0"
        rpy="0 0 0"/>


    <!-- =========================================================
         Robotiq 2F-85
         ========================================================= -->

    <xacro:robotiq_2f85_assembly mesh_dir="$(arg mesh_root)/robotiq"/>

</robot>
