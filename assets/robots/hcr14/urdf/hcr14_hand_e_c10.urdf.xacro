<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="hcr14_hand_e_c10">
  <xacro:arg name="mesh_root" default="${xacro.abs_filename('../primitive')}"/>
  <xacro:include filename="hcr14_macro.xacro"/>
  <xacro:include filename="../../../tools/hand_e_c10/urdf/assembly.xacro"/>
  <xacro:hcr14_robot mesh_dir="$(arg mesh_root)"/>
  <link name="base_link"/>
  <joint name="base_link_to_link0" type="fixed">
    <parent link="base_link"/><child link="link0"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="tool_mount"/>
  <joint name="flange_to_tool_mount" type="fixed">
    <parent link="flange"/><child link="tool_mount"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <xacro:hand_e_c10_assembly mesh_dir="${xacro.abs_filename('../../../tools/hand_e_c10/meshes')}"/>
</robot>
