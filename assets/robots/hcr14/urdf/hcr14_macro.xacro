<?xml version="1.0"?>
<!-- Experimental simulation convention. See ../README.md for measurements,
     uncertainties and local mesh frame contract. No manufacturer inertias. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="hcr14_robot" params="mesh_dir">
    <xacro:property name="primitive" value="${mesh_dir.rstrip('/').endswith('/primitive')}"/>
    <link name="link0">
      <xacro:if value="${primitive}">
        <visual><origin xyz="0 0 0.0535" rpy="0 0 0"/><geometry><cylinder radius="0.095" length="0.107"/></geometry><material name="hcr14_experimental"><color rgba="0.85 0.72 0.22 1"/></material></visual>
        <collision><origin xyz="0 0 0.0535" rpy="0 0 0"/><geometry><cylinder radius="0.095" length="0.107"/></geometry></collision>
      </xacro:if>
      <xacro:unless value="${primitive}">
        <visual><geometry><mesh filename="${mesh_dir}/link0.stl"/></geometry></visual>
        <collision><geometry><mesh filename="${mesh_dir}/link0.stl"/></geometry></collision>
      </xacro:unless>
      <!-- Simulation-only mass and box inertia estimate; not vendor data. -->
      <inertial><origin xyz="0 0 0.0535" rpy="0 0 0"/><mass value="5"/><inertia ixx="0.019812083333333334" iyy="0.019812083333333334" izz="0.030083333333333333" ixy="0" ixz="0" iyz="0"/></inertial>
    </link>
    <link name="link1">
      <xacro:if value="${primitive}">
        <visual><origin xyz="0 0 0.05" rpy="0 0 0"/><geometry><cylinder radius="0.075" length="0.1"/></geometry><material name="hcr14_experimental"><color rgba="0.85 0.72 0.22 1"/></material></visual>
        <collision><origin xyz="0 0 0.05" rpy="0 0 0"/><geometry><cylinder radius="0.075" length="0.1"/></geometry></collision>
        <visual><origin xyz="0 -0.0555 0.1" rpy="${pi/2} 0 0"/><geometry><cylinder radius="0.075" length="0.111"/></geometry><material name="hcr14_experimental"><color rgba="0.85 0.72 0.22 1"/></material></visual>
        <collision><origin xyz="0 -0.0555 0.1" rpy="${pi/2} 0 0"/><geometry><cylinder radius="0.075" length="0.111"/></geometry></collision>
      </xacro:if>
      <xacro:unless value="${primitive}">
        <visual><geometry><mesh filename="${mesh_dir}/link1.stl"/></geometry></visual>
        <collision><geometry><mesh filename="${mesh_dir}/link1.stl"/></geometry></collision>
      </xacro:unless>
      <!-- Simulation-only mass and box inertia estimate; not vendor data. -->
      <inertial><origin xyz="0 -0.0555 0.1" rpy="0 0 0"/><mass value="5"/><inertia ixx="0.01875" iyy="0.01875" izz="0.01875" ixy="0" ixz="0" iyz="0"/></inertial>
    </link>
    <link name="link2">
      <xacro:if value="${primitive}">
        <visual><origin xyz="0 -0.05 0" rpy="${pi/2} 0 0"/><geometry><cylinder radius="0.075" length="0.1"/></geometry><material name="hcr14_experimental"><color rgba="0.85 0.72 0.22 1"/></material></visual>
        <collision><origin xyz="0 -0.05 0" rpy="${pi/2} 0 0"/><geometry><cylinder radius="0.075" length="0.1"/></geometry></collision>
        <visual><origin xyz="0 -0.1 0.365" rpy="0 0 0"/><geometry><cylinder radius="0.061" length="0.73"/></geometry><material name="hcr14_experimental"><color rgba="0.85 0.72 0.22 1"/></material></visual>
        <collision><origin xyz="0 -0.1 0.365" rpy="0 0 0"/><geometry><cylinder radius="0.061" length="0.73"/></geometry></collision>
      </xacro:if>
      <xacro:unless value="${primitive}">
        <visual><geometry><mesh filename="${mesh_dir}/link2.stl"/></geometry></visual>
        <collision><geometry><mesh filename="${mesh_dir}/link2.stl"/></geometry></collision>
      </xacro:unless>
      <!-- Simulation-only mass and box inertia estimate; not vendor data. -->
      <inertial><origin xyz="0 -0.1 0.365" rpy="0 0 0"/><mass value="10"/><inertia ixx="0.45648666666666665" iyy="0.45648666666666665" izz="0.024806666666666668" ixy="0" ixz="0" iyz="0"/></inertial>
    </link>
    <link name="link3">
      <xacro:if value="${primitive}">
        <visual><origin xyz="0 0.03775 0" rpy="${pi/2} 0 0"/><geometry><cylinder radius="0.059" length="0.0755"/></geometry><material name="hcr14_experimental"><color rgba="0.85 0.72 0.22 1"/></material></visual>
        <collision><origin xyz="0 0.03775 0" rpy="${pi/2} 0 0"/><geometry><cylinder radius="0.059" length="0.0755"/></geometry></collision>
        <visual><origin xyz="-0.2694 0.0755 0" rpy="0 ${pi/2} 0"/><geometry><cylinder radius="0.045" length="0.5388"/></geometry><material name="hcr14_experimental"><color rgba="0.85 0.72 0.22 1"/></material></visual>
        <collision><origin xyz="-0.2694 0.0755 0" rpy="0 ${pi/2} 0"/><geometry><cylinder radius="0.045" length="0.5388"/></geometry></collision>
      </xacro:if>
      <xacro:unless value="${primitive}">
        <visual><geometry><mesh filename="${mesh_dir}/link3.stl"/></geometry></visual>
        <collision><geometry><mesh filename="${mesh_dir}/link3.stl"/></geometry></collision>
      </xacro:unless>
      <!-- Simulation-only mass and box inertia estimate; not vendor data. -->
      <inertial><origin xyz="-0.2694 0.0755 0" rpy="0 0 0"/><mass value="6"/><inertia ixx="0.0081" iyy="0.14920271999999996" izz="0.14920271999999996" ixy="0" ixz="0" iyz="0"/></inertial>
    </link>
    <link name="link4">
      <xacro:if value="${primitive}">
        <visual><origin xyz="0 0.0021 0" rpy="${pi/2} 0 0"/><geometry><cylinder radius="0.045" length="0.1512"/></geometry><material name="hcr14_experimental"><color rgba="0.85 0.72 0.22 1"/></material></visual>
        <collision><origin xyz="0 0.0021 0" rpy="${pi/2} 0 0"/><geometry><cylinder radius="0.045" length="0.1512"/></geometry></collision>
      </xacro:if>
      <xacro:unless value="${primitive}">
        <visual><geometry><mesh filename="${mesh_dir}/link4.stl"/></geometry></visual>
        <collision><geometry><mesh filename="${mesh_dir}/link4.stl"/></geometry></collision>
      </xacro:unless>
      <!-- Simulation-only mass and box inertia estimate; not vendor data. -->
      <inertial><origin xyz="0 0.0021 0" rpy="0 0 0"/><mass value="2"/><inertia ixx="0.0075" iyy="0.0075" izz="0.0075" ixy="0" ixz="0" iyz="0"/></inertial>
    </link>
    <link name="link5">
      <xacro:if value="${primitive}">
        <visual><origin xyz="0.0021 0 0" rpy="0 ${pi/2} 0"/><geometry><cylinder radius="0.045" length="0.1512"/></geometry><material name="hcr14_experimental"><color rgba="0.85 0.72 0.22 1"/></material></visual>
        <collision><origin xyz="0.0021 0 0" rpy="0 ${pi/2} 0"/><geometry><cylinder radius="0.045" length="0.1512"/></geometry></collision>
      </xacro:if>
      <xacro:unless value="${primitive}">
        <visual><geometry><mesh filename="${mesh_dir}/link5.stl"/></geometry></visual>
        <collision><geometry><mesh filename="${mesh_dir}/link5.stl"/></geometry></collision>
      </xacro:unless>
      <!-- Simulation-only mass and box inertia estimate; not vendor data. -->
      <inertial><origin xyz="0.0021 0 0" rpy="0 0 0"/><mass value="2"/><inertia ixx="0.0075" iyy="0.0075" izz="0.0075" ixy="0" ixz="0" iyz="0"/></inertial>
    </link>
    <link name="link6">
      <xacro:if value="${primitive}">
        <visual><origin xyz="0 0.0071 0" rpy="${pi/2} 0 0"/><geometry><cylinder radius="0.045" length="0.1412"/></geometry><material name="hcr14_experimental"><color rgba="0.85 0.72 0.22 1"/></material></visual>
        <collision><origin xyz="0 0.0071 0" rpy="${pi/2} 0 0"/><geometry><cylinder radius="0.045" length="0.1412"/></geometry></collision>
      </xacro:if>
      <xacro:unless value="${primitive}">
        <visual><geometry><mesh filename="${mesh_dir}/link6.stl"/></geometry></visual>
        <collision><geometry><mesh filename="${mesh_dir}/link6.stl"/></geometry></collision>
      </xacro:unless>
      <!-- Simulation-only mass and box inertia estimate; not vendor data. -->
      <inertial><origin xyz="0 0.0071 0" rpy="0 0 0"/><mass value="1"/><inertia ixx="0.00375" iyy="0.00375" izz="0.00375" ixy="0" ixz="0" iyz="0"/></inertial>
    </link>
    <joint name="joint1" type="revolute">
      <parent link="link0"/><child link="link1"/>
      <origin xyz="0 0 0.107" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <!-- effort is a simulation drive bound, not manufacturer rated torque. -->
      <limit lower="-6.283185307179586" upper="6.283185307179586" velocity="2.705260340591211" effort="1000"/>
    </joint>
    <joint name="joint2" type="revolute">
      <parent link="link1"/><child link="link2"/>
      <origin xyz="0 -0.111 0.1" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <!-- effort is a simulation drive bound, not manufacturer rated torque. -->
      <limit lower="-6.283185307179586" upper="6.283185307179586" velocity="2.705260340591211" effort="1000"/>
    </joint>
    <joint name="joint3" type="revolute">
      <parent link="link2"/><child link="link3"/>
      <origin xyz="0 0.002 0.73" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <!-- effort is a simulation drive bound, not manufacturer rated torque. -->
      <limit lower="-2.8797932657906435" upper="2.8797932657906435" velocity="4.014257279586958" effort="1000"/>
    </joint>
    <joint name="joint4" type="revolute">
      <parent link="link3"/><child link="link4"/>
      <origin xyz="-0.5388 -0.0022 0" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <!-- effort is a simulation drive bound, not manufacturer rated torque. -->
      <limit lower="-6.283185307179586" upper="6.283185307179586" velocity="4.71238898038469" effort="1000"/>
    </joint>
    <joint name="joint5" type="revolute">
      <parent link="link4"/><child link="link5"/>
      <origin xyz="-0.0777 -0.0735 0" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <!-- effort is a simulation drive bound, not manufacturer rated torque. -->
      <limit lower="-6.283185307179586" upper="6.283185307179586" velocity="4.71238898038469" effort="1000"/>
    </joint>
    <joint name="joint6" type="revolute">
      <parent link="link5"/><child link="link6"/>
      <origin xyz="-0.0735 -0.0777 0" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <!-- effort is a simulation drive bound, not manufacturer rated torque. -->
      <limit lower="-6.283185307179586" upper="6.283185307179586" velocity="4.71238898038469" effort="1000"/>
    </joint>
    <link name="flange"/>
    <joint name="link6_to_flange" type="fixed">
      <parent link="link6"/><child link="flange"/>
      <origin xyz="0 -0.0635 0" rpy="${pi/2} 0 0"/>
    </joint>
  </xacro:macro>
</robot>
